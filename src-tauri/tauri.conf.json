{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "LeeLauncher",
	"mainBinaryName": "LeeLauncher",
	"identifier": "com.leelauncher.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "LeeLauncher",
				"width": 1200,
				"height": 760,
				"minWidth": 960,
				"minHeight": 600,
				"center": true,
				"decorations": false,
				"transparent": false,
				"shadow": true,
				"visible": false,
				"backgroundColor": "#111113",
				"resizable": true,
				"create": false
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self' 'unsafe-inline'",
				"img-src": "'self' asset: http://asset.localhost data: blob: https:",
				"font-src": "'self' data:",
				"connect-src": "'self' ipc: http://ipc.localhost",
				"media-src": "'self' blob: data:",
				"object-src": "'none'",
				"base-uri": "'self'",
				"form-action": "'none'",
				"frame-src": "'none'"
			},
			"dangerousDisableAssetCspModification": ["style-src"],
			"assetProtocol": {
				"enable": true,
				"scope": []
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"createUpdaterArtifacts": false,
		"publisher": "leeonttev",
		"homepage": "https://github.com/leeonttev/LeeLauncher",
		"shortDescription": "LeeLauncher",
		"longDescription": "Лаунчер Minecraft",
		"category": "Game",
		"copyright": "leeonttev, GPL-3.0",
		"windows": {
			"webviewInstallMode": {
				"type": "downloadBootstrapper",
				"silent": true
			},
			"allowDowngrades": false,
			"nsis": {
				"installMode": "currentUser",
				"languages": ["Russian", "English"],
				"installerHooks": "./windows/hooks.nsh",
				"installerIcon": "icons/icon.ico"
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwNTBDRjhDOTA5NTMzNzYKUldSMk01V1FqTTlROFBLL2lPNmZObXVTSkNSbW9VTkd5WnFEWGJwMzZzZ2hMY1VKdHoyZERUcE4K",
			"endpoints": ["https://github.com/leeonttev/LeeLauncher/releases/latest/download/latest.json"],
			"requireSignedVersion": true,
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
